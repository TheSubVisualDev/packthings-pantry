# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# secrets - never commit
.env
.env*
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Scratch database the cascade cross-check builds and removes.
.cascade-check.db

.vercel
.env*

# The seeded design canvas is a ~2MB build artefact of the design skill; the
# .dc.html artboards beside it are the source and are kept.
design/*.html
!design/*.dc.html
