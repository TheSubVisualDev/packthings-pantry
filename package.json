    "check:estimates": "node --import ./scripts/ts-imports.mjs scripts/check-estimates.mjs",
    "check:receipt": "node --import ./scripts/ts-imports.mjs scripts/check-receipt.mjs",
    "check:match": "node --import ./scripts/ts-imports.mjs scripts/check-match.mjs",
    "check:cookbook": "node --import ./scripts/ts-imports.mjs scripts/check-cookbook.mjs",
    "check:recipe-tags": "node --import ./scripts/ts-imports.mjs scripts/check-recipe-tags.mjs",
    "check:tonight": "node --import ./scripts/ts-imports.mjs scripts/check-tonight.mjs",
    "check:step-timers": "node --import ./scripts/ts-imports.mjs scripts/check-step-timers.mjs"
